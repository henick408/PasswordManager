<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PasswordManager.Views.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Width="1280" Height="780"
        MinWidth="700">

    <Window.Resources>

    <ControlTemplate x:Key="NoHeaderExpanderTemplate"
                     TargetType="{x:Type Expander}">

        <ContentPresenter x:Name="ExpanderContent"
                          ContentSource="Content"
                          Visibility="Collapsed"/>

            <ControlTemplate.Triggers>

                <Trigger Property="IsExpanded"
                        Value="True">

                    <Setter TargetName="ExpanderContent"
                            Property="Visibility"
                            Value="Visible"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0"
                Background="LightGray">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0"
                            Margin="0 0 0 8">
                    <TextBlock Text="H KeyVault"
                               Padding="10 12"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <Separator/>
                </StackPanel>
                
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0 0 0 8">
                        <Label Content="VAULT"
                               Padding="10 8"/>
                        <Button Content="H All Passwords"
                                HorizontalContentAlignment="Left"
                                FontSize="12"
                                Padding="10 10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="ListPasswordsButton_OnClick"/>
                    </StackPanel>
                    
                    <DockPanel>
                        <Label DockPanel.Dock="Top"
                            Content="CATEGORIES"
                            FontWeight="SemiBold"/>
                        <ListView Background="Transparent"
                                  ItemsSource="{Binding Categories}"
                                  FontSize="14">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12 4"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </DockPanel>
                </DockPanel>
                
                
                <StackPanel Grid.Row="2" 
                            VerticalAlignment="Bottom">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10 "/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="H Sign in"
                            Click="SignInButton_OnClick"/>
                    <Button Content="H Logout"/>
                </StackPanel>
                
            </Grid>
        </Border>
        
        <Border Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0"
                      d:Margin="10"
                      Background="LightGray">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0"
                            Margin=" 8 16"
                            CornerRadius="8"
                            Background="#000050">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="H"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Foreground="DarkGray"/>
                            <TextBox Grid.Column="1" 
                                     BorderThickness="0"
                                     Foreground="DarkGray"
                                     Text="Search password"
                                     VerticalContentAlignment="Center"
                                     FontSize="18"
                                     Padding="16 0 0 0"
                                     d:Margin="14"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>
                    
                    <Button Grid.Column="1"
                            Content="+ New"
                            Height="40"
                            FontSize="14"
                            Margin="0 0 12 0"
                            Padding="12 8"
                            Click="CreatePassword_OnClick"/>
                    
                </Grid>
                    <!-- 
                        Będzie mozna też prawym przyciskiem dostać opcje:
                        Kopiowanie username, kopiowanie hasła, popup hasła itd
                    !-->
                    <ListBox Grid.Row="1"
                             Margin="16"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Passwords}"
                             SelectedItem="{Binding SelectedPassword, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             PreviewMouseLeftButtonDown="PasswordListBox_PreviewMouseDown"
                             PreviewMouseRightButtonDown="PasswordListBox_PreviewRightMouseDown">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            
                            <Style TargetType="controls:PasswordControl">
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="Width" Value="160"/>
                                <Setter Property="Height" Value="120"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                            
                        </ListBox.Resources>
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PasswordControl/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                
            </Grid>
        </Border>
        <!-- 
            Tutaj zrobi sie template żeby nie było strzałki
            Expander będzie się otwierał gdy będzie wybrane jakieś hasło ze środkowego panelu
        !-->
        <Expander Grid.Column="2"
                  ExpandDirection="Left"
                  IsExpanded="{Binding IsPasswordSelected, Mode=OneWay}"
                  Template="{StaticResource NoHeaderExpanderTemplate}">
            <Border Background="LightGray"
                Width="320"
                Padding="12"
                DataContext="{Binding SelectedPassword.PasswordEntry}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0 0 0 20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#FF9370DB"
                                Padding="6"
                                CornerRadius="4">
                            <TextBlock Text="{Binding Category}"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Width="Auto"
                                       HorizontalAlignment="Left"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Padding" Value="8 0"/>
                                </Style>
                            </StackPanel.Resources>
                            
                            <Button Content="H Edit"
                                    Margin="0 0 4 0"
                                    Click="EditPassword_OnClick"/>
                            <Button Content="H Delete"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="1">
                    <StackPanel.Resources>
                        <Style TargetType="Label">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0 0 0 4"/>
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Padding" Value="4 8"/>
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Margin" Value="0 0 0 8"/>
                        </Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Padding" Value="4 8"/>
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Margin" Value="0 0 0 8"/>
                        </Style>
                    </StackPanel.Resources>
                    
                    <Label Content="H URL"/>
                    <TextBox Text="{Binding Url}"/>
                    
                    <Label Content="H USERNAME"/>
                    <TextBox Text="{Binding Username}"/>
                    
                    <Label Content="H PASSWORD"/>
                    <PasswordBox Password="haslo123"/>
                    
                    <Label Content="H NOTES"/>
                    <TextBox Text="{Binding Notes}"
                             Height="200"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="WrapWithOverflow"/>
                </StackPanel>
            </Grid>
        </Border>
        </Expander>
    </Grid>
</Window>
