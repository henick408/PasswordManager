<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        xmlns:controls="using:PasswordManager.Views.UserControls"
        mc:Ignorable="d"
        x:Class="PasswordManager.Views.Windows.MainWindow"
        Title="MainWindow"
        Width="1280" Height="780" MinWidth="700"
        x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0"
                Background="LightGray">

            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="🔐 KeyVault"
                               Padding="10 12"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <Separator/>
                    <StackPanel>
                        <Label Content="VAULT"
                               Padding="10 8"/>
                        <Button Content="🗂️ All Passwords"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                Padding="10 10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="8"
                                Command="{Binding ClearSelectedCategoryCommand}"/>
                    </StackPanel>
                </StackPanel>
                
                <DockPanel Grid.Row="1">
                    
                    <Grid RowDefinitions="Auto *">
                        <Label Grid.Row="0"
                               Content="CATEGORIES"
                               FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" 
                                 Background="Transparent"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 FontSize="14">
                        </ListBox>
                    </Grid>
                </DockPanel>
                
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Bottom">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </StackPanel.Styles>    
                    <ToggleSwitch Content="{Binding BiometricDisplayName}"
                                  IsChecked="{Binding IsBiometricEnabled}"
                                  Command="{Binding ToggleBiometricCommand}"
                                  IsVisible="{Binding IsBiometricAvailable}"
                                  FontSize="12"
                                  Margin="10 0"/>
                    <Button Content="⚙️ Settings"/>
                    <Button Content="🚪 Logout"
                            Command="{Binding SignOutCommand}"/>
                </StackPanel>
                
            </Grid>
        </Border>
        
        <Border Grid.Column="1">
            <Grid RowDefinitions="70,*">

                <Grid Grid.Row="0"
                      Background="LightGray" ColumnDefinitions="*,Auto">

                    <Border Grid.Column="0"
                            Classes="searchBox"
                            Margin="8 16"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#C8C8C8"
                            Background="White">
                        <Border.Styles>
                            <Style Selector="Border.searchBox:focus-within">
                                <Setter Property="BorderBrush" Value="#1E4AFF"/>
                            </Style>
                            <!-- Keep the inner TextBox flat: Fluent changes its background and border on hover and focus. -->
                            <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="36,*">
                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#707070"/>
                            <TextBox Grid.Column="1"
                                     Classes="search"
                                     BorderThickness="0"
                                     Foreground="#202020"
                                     Text="{Binding PasswordSearch, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Search passwords…"
                                     PlaceholderForeground="#909090"
                                     VerticalContentAlignment="Center"
                                     FontSize="16"
                                     Padding="4 0 0 0"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>
                    
                    <Button Grid.Column="1"
                            Content="+ New"
                            FontSize="14"
                            Margin="0 0 12 0"
                            Padding=" 14 10"
                            Command="{Binding CreatePasswordCommand}"/>
                    
                </Grid>
                    <ListBox x:Name="PasswordList"
                             Grid.Row="1"
                             Margin="16"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Passwords}"
                             SelectedItem="{Binding SelectedPassword, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            
                            <Style Selector="controls|PasswordControl">
                                <Setter Property="Width" Value="200"/>
                                <Setter Property="Height" Value="100"/>
                            </Style>
                            
                        </ListBox.Styles>
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PasswordControl/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                
            </Grid>
        </Border>
        
        <Expander Grid.Column="2"
                  VerticalAlignment="Stretch"
                  ExpandDirection="Left"
                  IsExpanded="{Binding IsPasswordSelected}"
                  Theme="{StaticResource NoHeaderExpander}">
            <Border Background="LightGray"
                    Width="320"
                    Padding="12">
            <Grid RowDefinitions="120,*">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SelectedPassword?.PasswordEntry.Name}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0 0 0 20"/>
                    <Grid ColumnDefinitions="*,Auto">

                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#FF9370DB"
                                Padding="8"
                                Margin="0 0 8 0"
                                CornerRadius="4">
                            <TextBlock Text="{Binding SelectedPassword?.PasswordEntry.Category}"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            
                            <StackPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </StackPanel.Styles>
                            
                            <Button Content="✏️ Edit"
                                    Margin="0 0 4 0"
                                    Command="{Binding UpdatePasswordCommand}"/>
                            <Button Content="🗑️ Delete"
                                    Command="{Binding DeletePasswordCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="1"
                            Spacing="8">
                    <StackPanel.Styles>
                        <Style Selector="Label">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style Selector="StackPanel">
                            <Setter Property="Spacing" Value="4"/>
                        </Style>
                        <Style Selector="TextBox">
                            <Setter Property="Padding" Value="4 8"/>
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <StackPanel>
                        <Label Content="🌐 URL"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Url}"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="👤 USERNAME"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Username}"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="🔑 PASSWORD"/>
                        <controls:PasswordBox Name="PasswordTextBox"
                                 Password="{Binding SelectedPassword?.PasswordEntry.Password, Mode=TwoWay}"
                                 Padding="0"
                                 TextPadding="4 8"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="📝 NOTES"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Notes}"
                                 Height="200"
                                 AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        </Expander>
        
    </Grid>
</Window>
