<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        mc:Ignorable="d"
        x:Class="PasswordManager.Views.Windows.MainWindow"
        Title="MainWindow"
        Width="1280" Height="780"
        x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
        
    <Grid ColumnDefinitions="180, 200, Auto">
        
        <Border Grid.Column="0"
                Background="LightGray">
            <Grid RowDefinitions="Auto,*,100">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="H KeyVault"
                               Padding="10 12"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <Separator/>
                    <StackPanel>
                        <Label Content="VAULT"
                               Padding="10 8"/>
                        <Button Content="H All Passwords"
                                HorizontalContentAlignment="Left"
                                FontSize="12"
                                Padding="10 10"
                                Background="Transparent"
                                BorderBrush="Transparent"/>
                        <!-- d:Click="AllPasswordsButton_OnClick"/> -->
                    </StackPanel>
                </StackPanel>
                
                <DockPanel Grid.Row="1">
                    
                    <Grid RowDefinitions="Auto *">
                        <Label Grid.Row="0"
                               Content="CATEGORIES"
                               FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" 
                                 Background="Transparent"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 FontSize="14">
                        </ListBox>
                    </Grid>
                </DockPanel>
                
                
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Bottom">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </StackPanel.Styles>
                    <Button Content="H Settings"/>
                    <Button Content="H Logout"/>
                            <!-- d:Click="LogoutButton_OnClick"/> -->
                </StackPanel>
                
            </Grid>
        </Border>
        
    </Grid>
</Window>
