<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        xmlns:controls="using:PasswordManager.Views.UserControls"
        mc:Ignorable="d"
        x:Class="PasswordManager.Views.Windows.MainWindow"
        Title="MainWindow"
        Width="1280" Height="780" MinWidth="700"
        x:DataType="vm:MainViewModel">
    
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0"
                Background="LightGray">
            <Grid RowDefinitions="Auto,*,100">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="H KeyVault"
                               Padding="10 12"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <Separator/>
                    <StackPanel>
                        <Label Content="VAULT"
                               Padding="10 8"/>
                        <Button Content="H All Passwords"
                                HorizontalAlignment="Stretch"
                                FontSize="12"
                                Padding="10 10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="8"
                                Click="Button_OnClick"/>
                        <!-- Ten nowy "Click" tylko do momentu zaimplementowania ekranu logowania -->
                    </StackPanel>
                </StackPanel>
                
                <DockPanel Grid.Row="1">
                    
                    <Grid RowDefinitions="Auto *">
                        <Label Grid.Row="0"
                               Content="CATEGORIES"
                               FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" 
                                 Background="Transparent"
                                 ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory}"
                                 FontSize="14">
                        </ListBox>
                    </Grid>
                </DockPanel>
                
                
                <StackPanel Grid.Row="2"
                            VerticalAlignment="Bottom">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </StackPanel.Styles>    
                    <Button Content="H Settings"/>
                    <Button Content="H Logout"
                            Click="LogoutButton_OnClick"/>
                </StackPanel>
                
            </Grid>
        </Border>
        
        <Border Grid.Column="1">
            <Grid RowDefinitions="70,*">

                <Grid Grid.Row="0"
                      Background="LightGray" ColumnDefinitions="*,Auto">

                    <Border Grid.Column="0"
                            Margin=" 8 16"
                            CornerRadius="8"
                            Background="#000050">
                        <Grid ColumnDefinitions="36,*">
                            <TextBlock Grid.Column="0"
                                       Text="H"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       Foreground="DarkGray"/>
                            <TextBox Grid.Column="1" 
                                     BorderThickness="0"
                                     Foreground="DarkGray"
                                     Text="{Binding PasswordSearch, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     FontSize="18"
                                     Padding="16 0 0 0"
                                     Background="Transparent"/>
                        </Grid>
                    </Border>
                    
                    <Button Grid.Column="1"
                            Content="+ New"
                            Height="40"
                            FontSize="14"
                            Margin="0 0 12 0"
                            Padding="12 8"
                            Command="{Binding CreatePasswordCommand}"/>
                    
                </Grid>
                    <ListBox x:Name="PasswordList"
                             Grid.Row="1"
                             Margin="16"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Passwords}"
                             SelectedItem="{Binding SelectedPassword, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            
                            <Style Selector="controls|PasswordControl">
                                <Setter Property="Width" Value="160"/>
                                <Setter Property="Height" Value="120"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                            
                        </ListBox.Styles>
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PasswordControl/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                
            </Grid>
        </Border>
        
        <Expander Grid.Column="2"
                  VerticalAlignment="Stretch"
                  ExpandDirection="Left"
                  IsExpanded="{Binding IsPasswordSelected, Mode=OneWay}"
                  Theme="{StaticResource NoHeaderExpander}">
            <Border Background="LightGray"
                    Width="320"
                    Padding="12">
            <Grid RowDefinitions="120,*">

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SelectedPassword?.PasswordEntry.Name}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0 0 0 20"/>
                    <Grid ColumnDefinitions="*,*">

                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#FF9370DB"
                                Padding="6"
                                CornerRadius="4">
                            <TextBlock Text="{Binding SelectedPassword?.PasswordEntry.Category}"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       HorizontalAlignment="Left"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            
                            <StackPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Padding" Value="8 0"/>
                                </Style>
                            </StackPanel.Styles>
                            
                            <Button Content="H Edit"
                                    Margin="0 0 4 0"
                                    Command="{Binding UpdatePasswordCommand}"/>
                            <Button Content="H Delete"
                                    Command="{Binding DeletePasswordCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <StackPanel Grid.Row="1"
                            Spacing="8">
                    <StackPanel.Styles>
                        <Style Selector="Label">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style Selector="StackPanel">
                            <Setter Property="Spacing" Value="4"/>
                        </Style>
                        <Style Selector="TextBox">
                            <Setter Property="Padding" Value="4 8"/>
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </StackPanel.Styles>
                    
                    <StackPanel>
                        <Label Content="H URL"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Url}"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="H USERNAME"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Username}"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="H PASSWORD"/>
                        <TextBox Name="PasswordTextBox"
                                 Text="{Binding SelectedPassword?.PasswordEntry.Password}"
                                 PasswordChar="*"
                                 RevealPassword="{Binding IsPasswordRevealed}">
                            <TextBox.InnerRightContent>
                                <ToggleButton Content="H"
                                        IsChecked="{Binding IsPasswordRevealed}"/>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </StackPanel>
                    
                    <StackPanel>
                        <Label Content="H NOTES"/>
                        <TextBox Text="{Binding SelectedPassword?.PasswordEntry.Notes}"
                                 Height="200"
                                 AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        </Expander>
        
    </Grid>
</Window>
