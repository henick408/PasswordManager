<Window x:Class="PasswordManager.Views.Windows.AddEditPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PasswordManager.Views.Windows"
        mc:Ignorable="d"
        Title="PasswordEnterDialog" MinHeight="600" Width="470"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Window.Resources>

        <ControlTemplate x:Key="NoHeaderExpanderTemplate"
                         TargetType="{x:Type Expander}">
            <ContentPresenter x:Name="ExpanderContent"
                              ContentSource="Content"
                              Visibility="Collapsed"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded"
                         Value="True">
                    <Setter TargetName="ExpanderContent"
                            Property="Visibility"
                            Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0 0 0 8"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10 0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
        
            <Grid Grid.Row="0"
                  Margin="0 0 0 16">
                <TextBlock Text="Create Password"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontWeight="SemiBold"/>
            </Grid>
        
            <StackPanel Grid.Row="1"
                        Margin="0 0 0 16">
                <TextBlock Text="NAME"/>
                <TextBox Text="PlaceholderName"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2"
                        Margin="0 0 0 16">
                <TextBlock Text="URL"/>
                <TextBox Text="PlaceholderUrl"/>
            </StackPanel>
            
            <StackPanel Grid.Row="3"
                        Margin="0 0 0 16">
                <TextBlock Text="USERNAME"/>
                <TextBox Text="PlaceholderUsername"/>
            </StackPanel>
            
            <StackPanel Grid.Row="4"
                        Margin="0 0 0 16">
                <TextBlock Text="PASSWORD"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0"
                          Margin="0 0 8 0">
                        <PasswordBox Password="PlaceholderPassword"
                                     Grid.Column="0"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Padding="10 0 52 0"
                                     FontSize="12"
                                     FontFamily="Tahoma"/>
                        <Button Grid.Column="0"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Content="O"
                                Click="RevealPasswordButton_OnClick"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Name="GenerateButton"
                            Width="100"
                            Height="36"
                            Content="Generate"
                            BorderThickness="0"
                            Click="GeneratorExpander_OnClick"/>
                </Grid>
            </StackPanel>
            
            <!--
                Należy zaimplementować generator haseł 
            !-->
            <Expander Grid.Row="5"
                      IsExpanded="False"
                      Margin="0 0 0 16"
                      Name="GeneratorExpander"
                      Template="{StaticResource NoHeaderExpanderTemplate}">
                <Border Padding="16"
                        CornerRadius="8"
                        Background="LightGray">
                    <StackPanel>
                        <TextBlock Text="Generator"
                                   Margin="12 0 0 10"
                                   FontSize="14"/>
                        <TextBox Padding="8 0"
                                 Margin="0 0 0 8"
                                 Text="RandomPassword"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Height="30"
                                        Padding="8 0"
                                        Margin="0 0 4 0"
                                        Content="Copy"/>
                                <Button Height="30"
                                        Padding="8 0"
                                        Content="Regenerate"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Content="Fill"
                                    Padding="12 0"/>
                        </Grid>
                        <Separator Margin="0 12"/>
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="LENGTH"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"/>
                            <Slider Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0 0 12 0"/>
                                </Style>
                            </StackPanel.Resources>
                            <CheckBox Content="a-z"/>
                            <CheckBox Content="A-Z"/>
                            <CheckBox Content="0-9"/>
                            <CheckBox Content="!@#"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
            
            <StackPanel Grid.Row="6"
                        Margin="0 0 0 16">
                <TextBlock Text="CATEGORY"/>
                <ComboBox Height="36"
                          VerticalContentAlignment="Center"
                          Padding="10 0"
                          FontSize="12">
                    <ComboBoxItem Content="Social"/>
                    <ComboBoxItem Content="Work"/>
                    <ComboBoxItem Content="Finance"/>
                    <ComboBoxItem Content="Shopping"/>
                    <ComboBoxItem Content="Entertainment"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>
            </StackPanel>
        
            <StackPanel Grid.Row="7"
                        Margin="0 0 0 16">
                <TextBlock Text="NOTES"/>
                <TextBox x:Name="NotesBox"
                         Height="72"
                         Padding="10 2"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            
            <StackPanel Grid.Row="8"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Height="36">
                <Button Content="Cancel"
                        Margin="0 0 4 0"
                        Padding="18 0"
                        IsCancel="True"/>
                <Button Content="Save Changes"
                        Padding="20 0"
                        IsDefault="True"
                        Click="SaveChangesButton_OnClick"/>
            </StackPanel>
            
        </Grid>
    </Border>
</Window>
