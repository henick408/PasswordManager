<Window x:Class="PasswordManager.Views.Windows.AddEditPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Create Password" MinHeight="600" Width="470"
        WindowStartupLocation="CenterOwner"
        d:ResizeMode="NoResize"
        SizeToContent="Height">
    <!-- 
        !!!
        ResizeMode należy odkomentować w finalnym projekcie
        Jest zakomentowane tylko dlatego że na linuxie mi sie dziwnie okienko renderuje
        !!!
    !-->
    
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0 0 0 8"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10 0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
        
            <Grid Grid.Row="0"
                  Margin="0 0 0 16">
                <TextBlock x:Name="HeaderBlock"
                           Text="Create Password"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontWeight="SemiBold"/>
            </Grid>
        
            <StackPanel Grid.Row="1"
                        Margin="0 0 0 16">
                <TextBlock Text="NAME"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2"
                        Margin="0 0 0 16">
                <TextBlock Text="URL"/>
                <TextBox x:Name="UrlBox"/>
            </StackPanel>
            
            <StackPanel Grid.Row="3"
                        Margin="0 0 0 16">
                <TextBlock Text="USERNAME"/>
                <TextBox x:Name="UsernameBox"/>
            </StackPanel>
            
            <StackPanel Grid.Row="4"
                        Margin="0 0 0 16">
                <TextBlock Text="PASSWORD"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0"
                          Margin="0 0 8 0">
                        <PasswordBox x:Name="HiddenPasswordBox"
                                     PasswordChanged="HiddenPasswordBox_OnPasswordChanged"
                                     Grid.Column="0"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Padding="10 0 52 0"
                                     FontSize="12"
                                     FontFamily="Tahoma"/>
                        <TextBox x:Name="RevealedTextBox"
                                 TextChanged="RevealedTextBox_OnPasswordChanged"
                                 Grid.Column="0"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="10 0 52 0"
                                 FontSize="12"
                                 Visibility="Collapsed"/>
                        <ToggleButton Grid.Column="0"
                                      Width="28"
                                      Height="28"
                                      HorizontalAlignment="Right"
                                      Content="O"
                                      Checked="RevealButton_OnChecked"
                                      Unchecked="RevealButton_OnUnchecked"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Name="GenerateButton"
                            Width="100"
                            Height="36"
                            Content="Generate"
                            BorderThickness="0"
                            Click="GeneratorExpander_OnClick"/>
                </Grid>
            </StackPanel>
            
            <!--
                Należy zaimplementować generator haseł 
            !-->
            <Expander Grid.Row="5"
                      IsExpanded="False"
                      Margin="0 0 0 16"
                      Name="GeneratorExpander"
                      Template="{StaticResource NoHeaderExpanderTemplate}">
                <Border Padding="16"
                        CornerRadius="8"
                        Background="LightGray">
                    <StackPanel>
                        <TextBlock Text="Generator"
                                   Margin="12 0 0 10"
                                   FontSize="14"/>
                        <TextBox Padding="8 0"
                                 Margin="0 0 0 8"
                                 Text="RandomPassword"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Height="30"
                                        Padding="8 0"
                                        Margin="0 0 4 0"
                                        Content="Copy"/>
                                <Button Height="30"
                                        Padding="8 0"
                                        Content="Regenerate"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Content="Fill"
                                    Padding="12 0"/>
                        </Grid>
                        <Separator Margin="0 12"/>
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="LENGTH"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"/>
                            <Slider Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0 0 12 0"/>
                                </Style>
                            </StackPanel.Resources>
                            <CheckBox Content="a-z"/>
                            <CheckBox Content="A-Z"/>
                            <CheckBox Content="0-9"/>
                            <CheckBox Content="!@#"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
            
            <StackPanel Grid.Row="6"
                        Margin="0 0 0 16">
                <TextBlock Text="CATEGORY"/>
                <ComboBox x:Name="CategoryComboBox"
                    Height="36"
                          VerticalContentAlignment="Center"
                          Padding="10 0"
                          FontSize="12"/>
            </StackPanel>
        
            <StackPanel Grid.Row="7"
                        Margin="0 0 0 16">
                <TextBlock Text="NOTES"/>
                <TextBox x:Name="NotesBox"
                         Height="72"
                         Padding="10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            
            <StackPanel Grid.Row="8"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Height="36">
                <Button Content="Cancel"
                        Margin="0 0 4 0"
                        Padding="18 0"
                        IsCancel="True"/>
                <Button Content="Save Changes"
                        Padding="20 0"
                        IsDefault="True"
                        Click="SaveChangesButton_OnClick"/>
            </StackPanel>
            
        </Grid>
    </Border>
</Window>
