<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        xmlns:controls="using:PasswordManager.Views.UserControls"
        mc:Ignorable="d"
        x:Class="PasswordManager.Views.Windows.LoginRegisterWindow"
        Title="LoginRegisterWindow"
        MinHeight="380" Width="400"
        SizeToContent="Height"
        CanResize="False"
        x:DataType="vm:LoginRegisterViewModel">
    
    <Design.DataContext>
        <vm:LoginRegisterViewModel/>
    </Design.DataContext>
    
    <Border Padding="20 20 20 60"
            Background="LightGray">
        <Grid RowDefinitions="100,Auto">
            <TextBlock Grid.Row="0"
                       Text="{Binding HeaderText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="24"/>
            <StackPanel Grid.Row="1"
                        Spacing="16">
                <StackPanel>
                    <Label Content="EMAIL"/>
                    <TextBox Text="{Binding Email}"
                             Padding="8">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoginAttemptCommand}"/>
                            <KeyBinding Gesture="Return" Command="{Binding LoginAttemptCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Text="{Binding EmailError}"
                               IsVisible="{Binding IsEmailError}"
                               Foreground="Red"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="MASTER PASSWORD"/>
                    <controls:PasswordBox Password="{Binding MasterPassword, Mode=TwoWay}"
                                          TextPadding="8">
                        <controls:PasswordBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoginAttemptCommand}"/>
                            <KeyBinding Gesture="Return" Command="{Binding LoginAttemptCommand}"/>
                        </controls:PasswordBox.KeyBindings>
                    </controls:PasswordBox>
                    <TextBlock Text="{Binding MasterPasswordError}"
                               IsVisible="{Binding IsMasterPasswordError}"
                               Foreground="Red"/>
                </StackPanel>
                <Expander IsExpanded="{Binding IsRegister}"
                          Theme="{StaticResource NoHeaderExpander}">
                    <StackPanel>
                        <Label Content="CONFIRM PASSWORD"/>
                        <controls:PasswordBox Password="{Binding RepeatMasterPassword, Mode=TwoWay}"
                                              TextPadding="8">
                            <controls:PasswordBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding LoginAttemptCommand}"/>
                                <KeyBinding Gesture="Return" Command="{Binding LoginAttemptCommand}"/>
                            </controls:PasswordBox.KeyBindings>
                        </controls:PasswordBox>
                        <TextBlock Text="{Binding RepeatMasterPasswordError}"
                                   IsVisible="{Binding IsRepeatMasterPasswordError}"
                                   Foreground="Red"/>
                    </StackPanel>
                </Expander>
                <Separator/>
                <Button Padding="6"
                        Content="{Binding ButtonText}"
                        FontSize="16"
                        Foreground="#EEEEEE"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#FF1E4AFF"
                        Command="{Binding LoginAttemptCommand}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{Binding FooterText}"/>
                    <HyperlinkButton Content="{Binding HyperlinkText}"
                                     Command="{Binding SwapIsRegisterCommand}"
                                     Padding="0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
