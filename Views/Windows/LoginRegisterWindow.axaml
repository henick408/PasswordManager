<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="PasswordManager.Views.Windows.LoginRegisterWindow"
        Title="LoginRegisterWindow"
        MinHeight="380" Width="400"
        SizeToContent="Height"
        CanResize="False">
    <Border Padding="20 20 20 60"
            Background="LightGray">
        <Grid RowDefinitions="100,Auto">
            <TextBlock Grid.Row="0"
                       Text="Sign in"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="30"/>
            <StackPanel Grid.Row="1"
                        Spacing="16">
                <StackPanel>
                    <Label Content="EMAIL"/>
                    <TextBox Padding="8"/>
                </StackPanel>
                <StackPanel>
                    <Label Content="MASTER PASSWORD"/>
                    <TextBox Padding="8"/>
                </StackPanel>
                <Expander IsExpanded="True"
                          Theme="{StaticResource NoHeaderExpander}">
                    <StackPanel>
                        <Label Content="CONFIRM PASSWORD"/>
                        <TextBox Padding="8"/>
                    </StackPanel>
                </Expander>
                <Separator/>
                <Button Padding="6"
                        Content="Sign in"
                        FontSize="16"
                        Foreground="#EEEEEE"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#FF1E4AFF"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="Don't have an account?"/>
                    <HyperlinkButton Content="Create one!" Padding="0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
