<Window x:Class="PasswordManager.Views.Windows.AddEditPasswordDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        xmlns:controls="clr-namespace:PasswordManager.Views.UserControls"
        x:DataType="vm:AddEditPasswordViewModel"
        mc:Ignorable="d"
        MinHeight="600" Width="470"
        Title="AddEditPasswordDialog"
        SizeToContent="Height"
        CanResize="False">
    
    <Design.DataContext>
        <vm:AddEditPasswordViewModel/>
    </Design.DataContext>
    
    <Border Padding="16">
        <StackPanel Spacing="16">

            <StackPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Margin" Value="0 0 0 8"/>
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10 0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </StackPanel.Styles>
        
            <Grid>
                <TextBlock x:Name="HeaderBlock"
                           Text="Create Password"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontWeight="SemiBold"/>
            </Grid>
        
            <StackPanel>
                <TextBlock Text="NAME"/>
                <TextBox Text="{Binding PasswordEntry.Name}"/>
            </StackPanel>
            
            <StackPanel>
                <TextBlock Text="URL"/>
                <TextBox Text="{Binding PasswordEntry.Url}"/>
            </StackPanel>
            
            <StackPanel>
                <TextBlock Text="USERNAME"/>
                <TextBox Text="{Binding PasswordEntry.Username}"/>
            </StackPanel>
            
            <StackPanel>
                <TextBlock Text="PASSWORD"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Grid Grid.Row="0"
                          Margin="0 0 8 0">
                        <controls:PasswordBox Grid.Column="0"
                                 Password="{Binding PasswordEntry.Password}"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 TextPadding="10 0 52 0"
                                 FontSize="12">
                        </controls:PasswordBox>
                        
                    </Grid>
                    <ToggleButton Grid.Column="1"
                            Padding="10"
                            Content="Generate"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Background="Transparent"
                            IsChecked="{Binding IsGeneratorExpanded}"/>
                </Grid>
            </StackPanel>
            
            <Expander IsExpanded="{Binding IsGeneratorExpanded}"
                      Theme="{StaticResource NoHeaderExpander}">
                <Border Padding="16"
                        CornerRadius="8"
                        Background="LightGray">
                    <StackPanel>
                        <TextBlock Text="Generator"
                                   Margin="12 0 0 10"
                                   FontSize="14"/>
                        <TextBox Text="{Binding GeneratedPassword}"
                                 Padding="8 0"
                                 Margin="0 0 0 8"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Padding="8"
                                        Margin="0 0 4 0"
                                        Content="Copy"
                                        Command="{Binding CopyGeneratedPasswordToClipboardCommand}"/>
                                <Button Padding="8"
                                        Content="Regenerate"
                                        Command="{Binding GeneratePasswordCommand}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Content="Fill"
                                    Padding="8"
                                    Command="{Binding FillRandomPasswordCommand}"/>
                        </Grid>
                        <Separator Margin="0 12"/>
                        <Grid Margin="0 0 0 12" RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0 0 0 4">
                                <TextBlock Text="Password length:"
                                           VerticalAlignment="Center"
                                           Margin="0 0 6 0"/>
                                <NumericUpDown Height="30"
                                         Value="{Binding PasswordGeneratorLength}"
                                         ClipValueToMinMax="True"
                                         FormatString="0"
                                         Minimum="8"
                                         Maximum="64"
                                         Padding="8"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center">
                                    <NumericUpDown.Styles>
                                        <Style Selector="TextBox">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                            <Setter Property="Width" Value="40"></Setter>
                                        </Style>
                                    </NumericUpDown.Styles>
                                </NumericUpDown>
                                <TextBlock Text="characters"
                                           Margin="6 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Slider Grid.Row="1"
                                    Value="{Binding PasswordGeneratorLength}"
                                    Minimum="8"
                                    Maximum="64"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Styles>
                                <Style Selector="CheckBox">
                                    <Setter Property="Margin" Value="0 0 12 0"/>
                                </Style>
                            </StackPanel.Styles>
                            <CheckBox Content="abc"
                                      IsChecked="{Binding IsLowercase}"
                                      IsEnabled="{Binding IsLowercaseEnabled}"/>

                            <CheckBox Content="ABC"
                                      IsChecked="{Binding IsUppercase}"
                                      IsEnabled="{Binding IsUppercaseEnabled}"/>

                            <CheckBox Content="123"
                                      IsChecked="{Binding IsNumerics}"
                                      IsEnabled="{Binding IsNumericsEnabled}"/>

                            <CheckBox Content="!@#"
                                      IsChecked="{Binding IsSpecialSigns}"
                                      IsEnabled="{Binding IsSpecialSignsEnabled}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
            
            <StackPanel>
                <TextBlock Text="CATEGORY"/>
                <ComboBox HorizontalAlignment="Stretch"
                          FontSize="12"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding PasswordEntry.Category}"/>
            </StackPanel>
        
            <StackPanel>
                <TextBlock Text="NOTES"/>
                <TextBox Text="{Binding PasswordEntry.Notes}"
                         Height="72"
                         Padding="10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="Cancel"
                        Margin="0 0 4 0"
                        Padding="12"
                        Click="CancelButton_OnClick"/>
                <Button Content="Save Changes"
                        Padding="12"
                        Click="SaveChangesButton_OnClick"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>
