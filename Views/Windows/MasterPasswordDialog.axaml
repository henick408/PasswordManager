<Window x:Class="PasswordManager.Views.Windows.MasterPasswordDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PasswordManager.ViewModels"
        xmlns:controls="clr-namespace:PasswordManager.Views.UserControls"
        x:DataType="vm:MasterPasswordDialogViewModel"
        mc:Ignorable="d"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MasterPasswordDialogViewModel/>
    </Design.DataContext>

    <Border Padding="16">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"/>

            <StackPanel>
                <Label Content="MASTER PASSWORD"/>
                <controls:PasswordBox x:Name="PasswordInput"
                                      Password="{Binding Password, Mode=TwoWay}"
                                      TextPadding="8">
                    <controls:PasswordBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}"/>
                        <KeyBinding Gesture="Return" Command="{Binding ConfirmCommand}"/>
                        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
                    </controls:PasswordBox.KeyBindings>
                </controls:PasswordBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"/>
                <Button Content="OK"
                        Background="#FF1E4AFF"
                        Foreground="White"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
