<Window x:Class="PasswordManager.Views.Windows.LoginRegisterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="LoginRegisterScreen" MinHeight="380" Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Border Padding="20 20 20 60"
            Background="LightGray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       x:Name="HeaderTextBlock"
                       Text="Sign in"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="30"/>
            <StackPanel Grid.Row="1">
                <Label Content="EMAIL"/>
                <TextBox x:Name="EmailBox"
                         Padding="8"
                         Margin="0 0 0 12"/>
                <Label Content="MASTER PASSWORD"/>
                <PasswordBox x:Name="MasterPasswordBox" 
                             Padding="8"
                             Margin="0 0 0 12"/>
                <Expander x:Name="RegisterExpander"
                          IsExpanded="False"
                          Margin="0 0 0 8"
                          Template="{StaticResource NoHeaderExpanderTemplate}">
                    <StackPanel>
                        <Label Content="CONFIRM PASSWORD"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Padding="8"/>
                    </StackPanel>
                </Expander>
                <Separator Margin="0 0 0 8"/>
                <Border CornerRadius="8"
                        Background="#FF1E70FF"
                        Margin="0 0 0 16">
                    <Button x:Name="SignInButton"
                            Padding="4"
                            Content="Sign in"
                            FontSize="18"
                            Foreground="#EEEEEE"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="SignInButton_OnClick"/>
                </Border>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock>
                        <Run x:Name="AccountQuestionText"
                             Text="Don't have an account? " />
                        <Hyperlink Click="LoginRegisterSwitch_OnClick">
                            <Run x:Name="AccountActionText"
                                 Text="Create one" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
