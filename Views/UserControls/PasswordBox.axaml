<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:userControls="clr-namespace:PasswordManager.Views.UserControls"
             mc:Ignorable="d"
             x:Class="PasswordManager.Views.UserControls.PasswordBox"
             x:Name="Root">
    
    <UserControl.Styles>
        <Style Selector="userControls|PasswordBox.validationError TextBox">
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </UserControl.Styles>
    
    <TextBox Name="PasswordTextBox"
             Padding="{Binding TextPadding, ElementName=Root}"
             Text="{Binding Password, ElementName=Root, Mode=TwoWay}"
             PasswordChar="*">
        <TextBox.InnerRightContent>
            <ToggleButton Content="H"
                          IsChecked="{Binding #PasswordTextBox.RevealPassword, Mode=TwoWay}"
                          IsTabStop="False"/>
        </TextBox.InnerRightContent>
    </TextBox>
</UserControl>
