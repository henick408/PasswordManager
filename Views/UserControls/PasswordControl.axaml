
<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PasswordManager.ViewModels"
    x:Class="PasswordManager.Views.UserControls.PasswordControl"
    x:DataType="vm:PasswordControlViewModel"
    mc:Ignorable="d"
    d:DesignHeight="120" d:DesignWidth="160">
    
    <Design.DataContext>
        <vm:PasswordControlViewModel/>
    </Design.DataContext>
    
    <Grid>
        <Border BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="4"
                Background="White"
                Padding="10">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Username"
                              Click="CopyUsername_OnClick"/>
                    <MenuItem Header="Copy Password"
                              Click="CopyPassword_OnClick"/>
                    <MenuItem Header="Copy URL"
                              Click="CopyUrl_OnClick"/>
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PasswordEntry.Name}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PasswordEntry.Url}"/>
                <TextBlock Text="{Binding PasswordEntry.Username}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>